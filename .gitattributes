# Normalize line endings: store as LF, check out as LF on all platforms.
# This prevents spurious diffs when switching between Windows, WSL, and
# devcontainer environments where core.autocrlf defaults differ.
* text=auto eol=lf

# Shell scripts
*.sh        text eol=lf
*.bash      text eol=lf

# Infrastructure-as-Code
*.tf        text eol=lf
*.tfvars    text eol=lf
*.hcl       text eol=lf

# Config / data
*.yaml      text eol=lf
*.yml       text eol=lf
*.json      text eol=lf
*.toml      text eol=lf
*.ini       text eol=lf

# Docs / templates
*.md        text eol=lf
*.tpl       text eol=lf
*.txt       text eol=lf
*.helmignore text eol=lf

# Binary — no line-ending conversion
*.drawio    binary
*.svg       binary
*.png       binary
*.jpg       binary
*.jpeg      binary
*.ico       binary
