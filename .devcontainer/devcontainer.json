{
  "name": "gen3-kro",
  "remoteUser": "vscode",
  "containerUser": "vscode",
  "updateRemoteUserUID": true,

  "build": {
    "dockerfile": "../Dockerfile",
    "context": ".."
  },

  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",

  "initializeCommand": ["bash", "-c", "mkdir -p \"${USERPROFILE:-$HOME}/.aws/jayadeyemi\" \"${USERPROFILE:-$HOME}/.codex/sessions\"; find '${localWorkspaceFolder}/scripts' \\( -name '*.sh' \\) -exec chmod +x {} + 2>/dev/null; { [ -d '${localWorkspaceFolder}/terragrunt/live/aws' ] && find '${localWorkspaceFolder}/terragrunt/live/aws' \\( -name '*.sh' \\) -exec chmod +x {} + 2>/dev/null; }; true"],

  "mounts": [
    "source=${localEnv:USERPROFILE}/.aws/jayadeyemi,target=/home/vscode/.aws,type=bind,readonly,consistency=cached",
    "source=${localEnv:USERPROFILE}/.codex,target=/home/vscode/.codex,type=bind,consistency=delegated"
  ],


  "containerEnv": {
    "REPO_ROOT":                   "/workspaces/${localWorkspaceFolderBasename}",
    "AWS_PROFILE":                 "operator",
    "AWS_SHARED_CREDENTIALS_FILE": "/home/vscode/.aws/credentials",
    "AWS_CONFIG_FILE":             "/home/vscode/.aws/config"
  },


  "postCreateCommand": "sudo chown -R vscode:vscode /workspaces 2>/dev/null || true && bash /workspaces/${localWorkspaceFolderBasename}/scripts/container-init.sh setup",
  "postStartCommand": "bash /workspaces/${localWorkspaceFolderBasename}/scripts/container-init.sh connect",

  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "chat.tools.terminal.sandbox.enabled": false,
        "chat.instructionsFilesLocations": {
          ".github/instructions": true
        },
        "editor.tabSize": 2,
        "editor.insertSpaces": true,
        "files.trimTrailingWhitespace": true,
        "files.insertFinalNewline": true,
        "files.associations": {
          "*.hcl": "terragrunt"
        },
        "[yaml]": {
          "editor.defaultFormatter": "redhat.vscode-yaml"
        },
        "[terraform]": {
          "editor.defaultFormatter": "hashicorp.hcl"
        }
      },
      "extensions": [
        "hashicorp.hcl",
        "ms-kubernetes-tools.vscode-kubernetes-tools",
        "redhat.vscode-yaml",
        "openai.chatgpt",
        "4ops.terraform",
        "github.copilot-chat"
      ]
    }
  },

  "runArgs": [],

  "forwardPorts": [8080],

  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": true,
      "installOhMyZsh": true,
      "upgradePackages": true
    },
    "ghcr.io/devcontainers/features/git:1.3.8": {
      "version": "latest"
    }
  }
}
